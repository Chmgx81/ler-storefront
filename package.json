{
  "name": "ler-storefront",
  "private": true,
  "version": "1.0.0",
  "description": "A small, production-shaped stoneware storefront: real accounts, persisted orders, Stripe Checkout, and an agentic assistant.",
  "license": "MIT",
  "author": "LER contributors",
  "homepage": "https://github.com/Chmgx81/ler-storefront#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chmgx81/ler-storefront.git"
  },
  "bugs": {
    "url": "https://github.com/Chmgx81/ler-storefront/issues"
  },
  "keywords": [
    "storefront",
    "ecommerce",
    "react",
    "vite",
    "hono",
    "better-auth",
    "libsql",
    "turso",
    "stripe",
    "ai-agent"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "tsx watch server/index.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "tsc -b && vite build",
    "build:server": "tsc -p tsconfig.server.json --noEmit && esbuild server/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist-server/index.js && esbuild server/app.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist-server/api-function.js",
    "start": "NODE_ENV=production node dist-server/index.js",
    "preview": "vite preview --host 0.0.0.0",
    "db:migrate": "tsx server/migrate.ts",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.9",
    "@libsql/client": "^0.18.0",
    "@libsql/kysely-libsql": "^0.4.1",
    "better-auth": "^1.7.26",
    "dotenv": "^18.0.10",
    "hono": "^4.13.19",
    "kysely": "^0.29.9",
    "motion": "^12.23.12",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}

# Public origin of the storefront (what the browser sees). Must be https in production.
BETTER_AUTH_URL=http://localhost:5173
PORT=8787
DATABASE_PATH=data/ler.sqlite
# On Vercel these are injected by the Turso Marketplace integration.
# TURSO_DATABASE_URL=libsql://...
# TURSO_AUTH_TOKEN=...

# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=replace-with-a-long-random-string

# Comma-separated origins allowed to call the API. The BETTER_AUTH_URL origin is always allowed.
TRUSTED_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:8787

# Set to true only when a trusted reverse proxy replaces X-Forwarded-For.
TRUST_PROXY=false
TRUSTED_PROXIES=

# Email: without RESEND_API_KEY, all messages are written to MAIL_OUTBOX as JSON files.
MAIL_MODE=auto
MAIL_FROM=LER Studio <hello@ler.studio>
RESEND_API_KEY=
MAIL_OUTBOX=data/outbox

# Require clicking a verification link before sign-in works. Needs real email in production.
REQUIRE_EMAIL_VERIFICATION=false

# Comma-separated account emails with access to /api/admin and /admin.
ADMIN_EMAILS=

# Payments: demo takes no money; stripe uses hosted Checkout + signed webhooks.
PAYMENTS_MODE=demo
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Only for a non-commerce preview in production:
ALLOW_DEMO_PAYMENTS=false

# Agentic assistant (optional). Without a key, the UI uses local catalogue guidance.
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/muse-glimmer-30b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
ASSISTANT_RATE_MAX=20
ASSISTANT_MAX_TOOL_ROUNDS=2

# Order creation limit per IP.
ORDER_RATE_WINDOW_MS=600000
ORDER_RATE_MAX=10
